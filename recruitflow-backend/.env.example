# Copy to .env and fill in values — never commit .env
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=your-random-secret-here
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth callback. It must ROUTE THROUGH the frontend proxy so the auth
# cookies are set first-party to the site the user is on.
#   Local dev : http://localhost:3000/backend/auth/google/callback
#   Production: https://<your-vercel-domain>/backend/auth/google/callback
# Whatever you use here must also be added as an Authorized redirect URI in the
# Google Cloud Console (APIs & Services → Credentials → OAuth 2.0 Client).
GOOGLE_REDIRECT_URI=http://localhost:3000/backend/auth/google/callback
# Where the OAuth callback sends the browser after login. Used as a fallback;
# the backend also honours the (allowlisted) origin the flow started on.
#   Local dev : http://localhost:3000
#   Production: https://<your-vercel-domain>
FRONTEND_URL=http://localhost:3000
# Extra frontend origins allowed as OAuth redirect targets (comma-separated).
# Localhost is always allowed, so this is only needed for additional prod hosts.
ALLOWED_FRONTEND_ORIGINS=
# Cookies require HTTPS when true. Set to false for local HTTP dev, true in prod.
COOKIE_SECURE=false
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REDIS_URL=redis://localhost:6379/0
